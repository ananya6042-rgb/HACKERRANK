#include <bits/stdc++.h>
using namespace std;

int equalStacks(int n1, vector<int>& h1, int n2, vector<int>& h2, int n3, vector<int>& h3) {
    int s1 = accumulate(h1.begin(), h1.end(), 0);
    int s2 = accumulate(h2.begin(), h2.end(), 0);
    int s3 = accumulate(h3.begin(), h3.end(), 0);

    int i1 = 0, i2 = 0, i3 = 0;

    while (true) {
        if (s1 == s2 && s2 == s3)
            return s1;

        if (s1 >= s2 && s1 >= s3)
            s1 -= h1[i1++];
        else if (s2 >= s1 && s2 >= s3)
            s2 -= h2[i2++];
        else
            s3 -= h3[i3++];
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n1, n2, n3;
    cin >> n1 >> n2 >> n3;

    vector<int> h1(n1), h2(n2), h3(n3);

    for (int i = 0; i < n1; i++) cin >> h1[i];
    for (int i = 0; i < n2; i++) cin >> h2[i];
    for (int i = 0; i < n3; i++) cin >> h3[i];

    cout << equalStacks(n1, h1, n2, h2, n3, h3) << "\n";
    return 0;
}
